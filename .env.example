# Environment for the container (Coolify: Environment Variables).
APP_URL=https://freitach.arns.dev
# Port the app listens on inside the container (default 3500).
PORT=3500
DATABASE_URL=postgres://freitach:secret@your-postgres:5432/freitach
# First start only: you, as admin and default host. The login link appears in the log.
ADMIN_NAME=Patrick
ADMIN_PHONE=0170 1234567
# First start only: the default host's usual restaurant, used when nobody picks another.
DEFAULT_RESTAURANT_NAME=Pizzeria Rustica
DEFAULT_RESTAURANT_URL=https://www.lieferando.de/speisekarte/pizzeria-rustica-3?c_id=01a0f6bc-5014-7255-9c76-1fcad61fad69
# Optional: the bot's own number (digits with country code, e.g. 491701234567) to link
# WhatsApp with a pairing code instead of scanning the QR code shown in the app.
PAIRING_PHONE=
# Optional: a group id (…@g.us) for announcements; the bot logs its groups when it connects.
WHATSAPP_GROUP=
# Optional: WHATSAPP=off runs without the bot (messages are only logged).
WHATSAPP=
# Optional: lets Claude read the WhatsApp messages no command matches. Admins can also enter
# the key on the people page (Leute → Claude), which then takes precedence.
ANTHROPIC_API_KEY=
# Optional: another Claude model for that (default claude-haiku-5-5).
ASSISTANT_MODEL=
