# Copy to .env next to docker-compose.yml and fill in.
APP_URL=https://freitach.arns.dev
APP_PORT=3000
POSTGRES_PASSWORD=change-me
# First start only: you, as admin and default host. The login link appears in the app's log.
ADMIN_NAME=Patrick
ADMIN_PHONE=0170 1234567
# Shared secret between app and bot, e.g. `openssl rand -hex 32`.
BOT_TOKEN=change-me
# Optional: the bot's own number (digits only, e.g. 491701234567) to link by pairing code instead of QR.
PAIRING_PHONE=
# Optional: a group JID (…@g.us) for announcements; list groups via the bot's /groups endpoint.
WHATSAPP_GROUP=
